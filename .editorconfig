# Shared editor settings: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,bash,sh,js}]
indent_style = space
indent_size = 4

[*.js]
indent_size = 2

[*.{yml,yaml,css,html}]
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 1

[*.md]
trim_trailing_whitespace = false
